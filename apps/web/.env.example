# Optional build-tool privacy setting. Product telemetry is not installed.
NEXT_TELEMETRY_DISABLED=1
# P1 server configuration; replace with a reserved origin and owned database connection.
# This example contains no password and cannot be used as a public deployment config.
PUBLIC_ORIGIN=https://neutralisp.tinywarden.com
DATABASE_URL=postgresql://tinywarden@localhost/tinywarden
PORT=10007
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_STALE_AFTER_SECONDS=180

# Temporary owner-selected development exception; all other values keep 15 characters.
TW_ALLOW_SHORT_OPERATOR_PASSWORD=0

# P4 notifications are opt-in; prepare actual values only in ignored private config.
# Capture and SMTP need an explicit guarded configure command before any job can run.
NOTIFICATIONS_TRANSPORT=disabled
NOTIFICATIONS_INCLUDE_WARNINGS=true
NOTIFICATIONS_RECOVERIES=true
# NOTIFICATIONS_FROM=alerts@example.test
# NOTIFICATIONS_TO=operator@example.test
# SMTP_HOST=smtp.example.test
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=replace-locally
# SMTP_PASSWORD=replace-locally
