[Unit]
Description=TinyWarden control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/tinywarden/tinywarden/apps/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/home/tinywarden/tinywarden/apps/web/.env.production.local
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node node_modules/next/dist/bin/next start --hostname 0.0.0.0
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
