[Unit]
Description=TinyWarden bounded observation retention
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/tinywarden/tinywarden/apps/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/home/tinywarden/tinywarden/apps/web/.env.production.local
EnvironmentFile=/home/tinywarden/tinywarden/apps/web/.env.jobs.local
ExecStart=/usr/bin/env node --import tsx scripts/retention.ts --expected-database ${TW_MAINTENANCE_DATABASE} --apply
TimeoutStartSec=45s
TimeoutStopSec=40s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
