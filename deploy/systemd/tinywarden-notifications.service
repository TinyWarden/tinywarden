[Unit]
Description=TinyWarden bounded notification sampling and dispatch
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tinywarden
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=%h/tinywarden/.env.production.local
EnvironmentFile=%h/tinywarden/.env.jobs.local
EnvironmentFile=%h/tinywarden/.env.notifications.local
ExecStart=/usr/bin/env node dist/native-jobs/current/notifications.mjs run --expected-database ${TW_MAINTENANCE_DATABASE}
TimeoutStartSec=210s
TimeoutStopSec=40s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
