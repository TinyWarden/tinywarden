[Unit]
Description=TinyWarden account verification and recovery delivery
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tinywarden
Environment=NODE_ENV=production
EnvironmentFile=%h/tinywarden/.env.production.local
EnvironmentFile=-%h/tinywarden/.env.notifications.local
EnvironmentFile=-%h/tinywarden/.env.account-emails.local
ExecStart=/usr/bin/env node dist/native-jobs/current/account-emails.mjs --expected-database ${TW_MAINTENANCE_DATABASE}
EnvironmentFile=%h/tinywarden/.env.jobs.local
TimeoutStartSec=80s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
