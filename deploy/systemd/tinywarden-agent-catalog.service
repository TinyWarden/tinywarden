[Unit]
Description=TinyWarden verified agent release catalogue
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tinywarden
Environment=NODE_ENV=production
EnvironmentFile=%h/tinywarden/.env.production.local
EnvironmentFile=%h/tinywarden/.env.jobs.local
ExecStart=/usr/bin/env node dist/native-jobs/current/agent-catalog.mjs --expected-database ${TW_MAINTENANCE_DATABASE}
TimeoutStartSec=150s
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
