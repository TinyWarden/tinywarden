{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TinyWarden skill notification Details v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "healthy",
                "warning",
                "critical"
              ]
            }
          },
          "message_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "parameters": {
            "type": "object",
            "maxProperties": 16,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "reason_param": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      },
                      "required": [
                        "reason_param"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "fact": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,63}$"
                        },
                        "type": {
                          "enum": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      },
                      "required": [
                        "fact",
                        "type"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "setting": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      },
                      "required": [
                        "setting"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "catalog_key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      },
                      "required": [
                        "catalog_key"
                      ]
                    }
                  ]
                },
                "marks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "bold",
                      "italic",
                      "underline"
                    ]
                  }
                },
                "precision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "plural": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "one_key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "other_key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": [
                    "one_key",
                    "other_key"
                  ]
                }
              },
              "required": [
                "source"
              ],
              "not": {
                "required": [
                  "precision",
                  "plural"
                ]
              }
            }
          },
          "marks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "bold",
                "italic",
                "underline"
              ]
            }
          }
        },
        "required": [
          "reason",
          "states",
          "message_key",
          "parameters"
        ]
      }
    }
  },
  "required": [
    "format",
    "rules"
  ]
}
