{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TinyWarden skill repository catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "skills"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "skills": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "name",
          "description",
          "content_sha256",
          "archive"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}/[a-z][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "asset",
              "sha256",
              "size"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "asset": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.zip$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10485760
              }
            }
          }
        }
      }
    }
  }
}
